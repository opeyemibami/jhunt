# Copy to .env and fill in. Never commit .env. Every value below is a placeholder.
# The app reads environment variables only. Locally, load this file with
#   export UV_ENV_FILE=.env      (then `uv run ...` as usual)
# Docker Compose reads .env by itself.

# --- Postgres (compose service: db) ---
POSTGRES_USER=jhunt
POSTGRES_PASSWORD=change-me
POSTGRES_DB=jhunt
# POSTGRES_HOST and POSTGRES_PORT are both required; the app has no defaults and
# refuses to start without them.
# Host port for the db container. Use another (e.g. 5433) if something else already holds 5432.
POSTGRES_PORT=your-db-port
# Where the app connects. localhost for the compose db; a Cloud SQL host after migration.
POSTGRES_HOST=your-db-host

# --- Google Cloud Storage (ADR 0002; created by infra/gcp/setup.sh) ---
GCP_PROJECT=your-project-id
GCS_STAGING_BUCKET=jhunt-staging-yoursuffix
GCS_RECORDS_BUCKET=jhunt-records-yoursuffix
# Local path to Application Default Credentials that impersonate jhunt-app, made by:
#   gcloud auth application-default login --impersonate-service-account=jhunt-app@<project>.iam.gserviceaccount.com
# This writes a short-lived-token config, not a service account key. Keep it outside the repo.
GOOGLE_APPLICATION_CREDENTIALS=/home/you/.config/gcloud/application_default_credentials.json
